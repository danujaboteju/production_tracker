<div class="min-h-screen bg-slate-100 p-6">
  <div class="mx-auto max-w-4xl">
    <div class="mb-6">
      <%= link_to "&larr; Back to Team Members".html_safe, admin_fabricators_path,
          class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">Edit Team Member</h1>
    </div>

    <% if @fabricator.errors.any? %>
      <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800">
        <%= @fabricator.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="rounded-xl bg-white p-5 shadow">
      <%= form_with model: [:admin, @fabricator], local: true, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :name, "Name", class: "block text-xs font-semibold text-slate-600" %>
          <%= form.text_field :name, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
          <%= form.check_box :active, class: "h-4 w-4 rounded border-slate-300" %>
          Active
        </label>

        <fieldset>
          <legend class="block text-xs font-semibold text-slate-600">Assigned Operations</legend>
          <% assigned_codes = @fabricator.assigned_operation_codes %>
          <div class="mt-2 grid gap-2 md:grid-cols-2">
            <% @operation_options.each do |code, name| %>
              <label class="flex items-start gap-2 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">
                <%= check_box_tag "fabricator[operation_codes][]", code, assigned_codes.include?(code), id: "fabricator_operation_codes_#{code}", class: "mt-0.5 h-4 w-4 rounded border-slate-300" %>
                <span><%= code %> &mdash; <%= name %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="flex gap-2">
          <%= form.submit "Save", class: "cursor-pointer rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
          <%= link_to "Cancel", admin_fabricators_path,
              class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
