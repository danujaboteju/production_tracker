<div class="min-h-screen bg-slate-100 p-6">
  <div class="mx-auto max-w-5xl">
    <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div>
        <%= link_to "&larr; Back to Jobs".html_safe, admin_jobs_path,
            class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>
        <h1 class="mt-3 text-3xl font-bold text-slate-900">Fabricators / Welders</h1>
      </div>
    </div>

    <% if notice.present? %>
      <div class="mb-4 rounded-lg bg-green-100 px-4 py-3 text-green-800">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800">
        <%= alert %>
      </div>
    <% end %>

    <% if @fabricator.errors.any? %>
      <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800">
        <%= @fabricator.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="mb-6 rounded-xl bg-white p-5 shadow">
      <h2 class="text-lg font-bold text-slate-900">Add Fabricator / Welder</h2>

      <%= form_with model: [:admin, @fabricator], local: true, class: "mt-4 grid gap-3 md:grid-cols-[1fr_auto] md:items-end" do |form| %>
        <div>
          <%= form.label :name, "Name", class: "block text-xs font-semibold text-slate-600" %>
          <%= form.text_field :name, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <%= form.hidden_field :active, value: true %>
        <%= form.submit "Add", class: "cursor-pointer rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
      <% end %>
    </div>

    <div class="overflow-hidden rounded-xl bg-white shadow">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="px-4 py-3 text-left text-sm font-semibold">Name</th>
            <th class="px-4 py-3 text-left text-sm font-semibold">Status</th>
            <th class="px-4 py-3 text-right text-sm font-semibold">Action</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-200">
          <% @fabricators.each do |fabricator| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-3 font-semibold text-slate-900"><%= fabricator.name %></td>
              <td class="px-4 py-3">
                <% if fabricator.active? %>
                  <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800">Active</span>
                <% else %>
                  <span class="rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-700">Inactive</span>
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to "Edit", edit_admin_fabricator_path(fabricator),
                    class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
              </td>
            </tr>
          <% end %>

          <% if @fabricators.empty? %>
            <tr>
              <td colspan="3" class="px-4 py-8 text-center text-slate-500">No fabricators or welders added yet.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
