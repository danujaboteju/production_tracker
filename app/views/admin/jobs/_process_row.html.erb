<% status_styles = {
  "Draft" => "background-color: #e2e8f0; color: #334155;",
  "Posted" => "background-color: #dbeafe; color: #1e40af;",
  "In Progress" => "background-color: #fef3c7; color: #92400e;",
  "Partially Completed" => "background-color: #ede9fe; color: #5b21b6;",
  "Completed" => "background-color: #dcfce7; color: #166534;",
  "On Hold" => "background-color: #ffedd5; color: #9a3412;",
  "Cancelled" => "background-color: #fee2e2; color: #991b1b;"
} %>

<div class="grid gap-4 px-4 py-4 md:grid-cols-[8rem_1fr_11rem_1.4fr] md:items-start">
  <div>
    <span class="inline-flex rounded-md px-3 py-1 text-xs font-bold tracking-wide text-white" style="background-color: #334155; color: white;">
      <%= process.process_code %>
    </span>
  </div>

  <div>
    <div class="font-semibold text-slate-900"><%= process.process_name %></div>

    <% if process.status == "Completed" && process.completed_at.present? %>
      <div class="mt-1 text-sm text-slate-500">
        Completed <%= process.completed_at.in_time_zone.strftime("%d/%m/%Y %I:%M %p") %>
      </div>
    <% end %>

    <% if process.status == "On Hold" && process.hold_reason.present? %>
      <div class="mt-2 rounded-md px-3 py-2 text-sm text-slate-800" style="background-color: #fff7ed; border: 1px solid #fed7aa;">
        <span class="font-semibold">Hold reason:</span>
        <%= process.hold_reason %>
      </div>
    <% end %>
  </div>

  <div>
    <span class="inline-flex rounded-full px-3 py-1 text-xs font-bold" style="<%= status_styles.fetch(process.status, 'background-color: #e2e8f0; color: #334155;') %>">
      <%= process.status %>
    </span>
  </div>

  <div class="flex flex-wrap items-start gap-2">
    <% if process.status == "Posted" %>
      <span class="text-sm text-slate-500">Waiting for previous process</span>
    <% end %>

    <% if process.status == "In Progress" %>
      <%= button_to "Mark Completed",
          complete_admin_job_job_process_path(job, process),
          method: :patch,
          form_class: "inline-block",
          class: "cursor-pointer rounded-md px-3 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-90",
          style: "background-color: #16a34a; color: white; cursor: pointer;" %>

      <details class="w-full md:w-auto">
        <summary class="inline-flex cursor-pointer list-none rounded-md px-3 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-90" style="background-color: #ea580c; color: white; cursor: pointer;">
          Put On Hold
        </summary>

        <div class="mt-3 rounded-lg border border-orange-200 bg-orange-50 p-3">
          <%= form_with url: hold_admin_job_job_process_path(job, process), method: :patch, local: true, class: "flex flex-col gap-2 sm:flex-row" do %>
            <%= text_field_tag :hold_reason, nil,
                placeholder: "Hold reason",
                class: "min-w-0 flex-1 rounded-md border border-slate-300 px-3 py-2 text-sm" %>

            <%= submit_tag "Save Hold",
                class: "cursor-pointer rounded-md px-3 py-2 text-sm font-semibold text-white hover:opacity-90",
                style: "background-color: #c2410c; color: white; cursor: pointer;" %>
          <% end %>
        </div>
      </details>
    <% end %>

    <% if process.status == "On Hold" %>
      <%= button_to "Resume",
          resume_admin_job_job_process_path(job, process),
          method: :patch,
          form_class: "inline-block",
          class: "cursor-pointer rounded-md px-3 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-90",
          style: "background-color: #2563eb; color: white; cursor: pointer;" %>

      <%= button_to "Mark Completed",
          complete_admin_job_job_process_path(job, process),
          method: :patch,
          form_class: "inline-block",
          class: "cursor-pointer rounded-md px-3 py-2 text-sm font-semibold text-white shadow-sm hover:opacity-90",
          style: "background-color: #16a34a; color: white; cursor: pointer;" %>
    <% end %>


    <% unless process.status.in?(["Posted", "In Progress", "On Hold", "Completed"]) %>
      <span class="text-sm text-slate-500">No actions available</span>
    <% end %>
  </div>
</div>
