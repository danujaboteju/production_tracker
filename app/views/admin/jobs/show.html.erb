<style>
  dialog.production-log-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }

  @supports (height: 100dvh) {
    dialog.production-log-dialog {
      max-height: calc(100dvh - 2rem);
    }
  }

  dialog.production-log-dialog::backdrop {
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(3px);
  }
</style>

<div class="min-h-screen bg-slate-100 p-6">
  <div class="mx-auto max-w-6xl">
    <% if notice.present? %>
      <div class="mb-4 rounded-lg bg-green-100 px-4 py-3 text-green-800">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800">
        <%= alert %>
      </div>
    <% end %>

    <div class="mb-6">
      <%= link_to "&larr; Back to Jobs".html_safe, admin_jobs_path,
          class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>

      <% job_status_style =
        case @job.status
        when "Completed"
          "background-color: #dcfce7; color: #166534;"
        when "In Progress"
          "background-color: #fef3c7; color: #92400e;"
        when "On Hold"
          "background-color: #f3e8ff; color: #6b21a8;"
        when "Released"
          "background-color: #dbeafe; color: #1e40af;"
        when "Cancelled"
          "background-color: #fee2e2; color: #991b1b;"
        else
          "background-color: #e2e8f0; color: #334155;"
        end
      %>

      <% job_closed = @job.status.in?(["Completed", "Cancelled"]) %>

      <div class="mt-4">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-3xl font-bold text-slate-900"><%= @job.job_no %></h1>

          <span class="rounded-full px-3 py-1 text-xs font-semibold" style="<%= job_status_style %>">
            <%= @job.status %>
          </span>
        </div>

        <div class="mt-5 grid gap-y-3" style="grid-template-columns: minmax(260px, max-content) max-content; column-gap: 4rem;">
          <div>
            <div class="text-sm font-semibold text-slate-500">Customer</div>
            <div class="mt-1 text-slate-900"><%= @job.customer_name %></div>
          </div>

          <div>
            <div class="text-sm font-semibold text-slate-500">Due Date</div>
            <div class="mt-1 text-slate-900"><%= @job.due_date&.strftime("%d/%m/%Y") || "-" %></div>
          </div>
        </div>

        <% if @job.notes.present? %>
          <div class="mt-4">
            <div class="text-sm font-semibold text-slate-500">Notes</div>
            <div class="mt-1 whitespace-pre-line text-slate-900"><%= @job.notes %></div>
          </div>
        <% end %>

        <div class="flex flex-wrap items-center gap-2" style="margin-top: 32px;">
          <% unless job_closed || @job.status == "On Hold" %>
            <%= button_to "Put Job On Hold",
                admin_job_path(@job, job: { status: "On Hold" }),
                method: :patch,
                form_class: "inline-block",
                class: "cursor-pointer rounded-md bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
          <% end %>

          <% unless job_closed %>
            <%= button_to "Mark Job Completed",
                admin_job_path(@job, job: { status: "Completed" }),
                method: :patch,
                form_class: "inline-block",
                form: { data: { turbo_confirm: "Mark this job as completed?" } },
                class: "cursor-pointer rounded-md bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
          <% end %>

          <% unless job_closed %>
            <%= button_to "Cancel Job",
                admin_job_path(@job, job: { status: "Cancelled" }),
                method: :patch,
                form_class: "inline-block",
                form: { data: { turbo_confirm: "Cancel this job?" } },
                class: "cursor-pointer rounded-md bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
          <% end %>

          <% if @job.status.in?(["Draft", "Released", "In Progress"]) %>
            <%= link_to "Edit Job", edit_admin_job_path(@job),
                class: "rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
          <% end %>

          <% if @job.status == "Draft" %>
            <%= button_to "Release Job",
                release_admin_job_path(@job),
                method: :patch,
                form_class: "inline-block",
                form: { data: { turbo_confirm: "Release this job to production?" } },
                class: "cursor-pointer rounded-md bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
          <% end %>

          <%= button_to "Delete Job",
              admin_job_path(@job),
              method: :delete,
              form_class: "inline-block",
              form: { data: { turbo_confirm: "Are you sure you want to delete this job? This will also delete its job processes." } },
              class: "cursor-pointer rounded-md bg-slate-800 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
        </div>
      </div>
    </div>

    <div class="rounded-xl bg-white p-6 shadow">
      <div class="mb-5 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="text-xl font-bold text-slate-900">Job Process Pipeline</h2>
          <p class="mt-1 text-sm text-slate-500">Stages are advisory and do not block process actions.</p>
        </div>

        <% if @job.status == "Draft" %>
          <div class="rounded-lg px-4 py-3 text-sm font-semibold" style="background-color: #eff6ff; color: #1e40af;">
            Release this job when it is ready for production.
          </div>
        <% end %>
      </div>

      <% processes = @job.job_processes.to_a.sort_by { |process| [process.stage || process.stage_no || 999, process.id || 0] } %>
      <% processes_by_stage = processes.group_by { |process| process.stage || process.stage_no } %>

      <% if processes.any? %>
        <div class="space-y-5">
          <% JobProcess::STAGE_MAP.keys.sort.each do |stage_no| %>
            <% stage_processes = processes_by_stage[stage_no] || [] %>
            <% next if stage_processes.empty? %>

            <section class="overflow-hidden rounded-xl border border-slate-200 bg-white">
              <div class="border-b border-slate-200 px-4 py-3" style="background-color: #f8fafc;">
                <h3 class="text-base font-bold text-slate-900">
                  Stage <%= stage_no %> &mdash; <%= JobProcess.stage_name_for(stage_no) %>
                </h3>
              </div>

              <div class="divide-y divide-slate-200">
                <% stage_processes.each do |process| %>
                  <%= render "admin/jobs/process_row", job: @job, process: process %>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-lg border border-dashed border-slate-300 px-4 py-8 text-center text-slate-500">
          No processes selected for this job.
        </div>
      <% end %>
    </div>

<% new_log_modal_id = "production-log-modal-new" %>
<% process_options = @production_log_processes.map { |process| [process.process_code, process.process_code] }.uniq %>

<div class="mt-6 rounded-xl bg-white p-6 shadow">
  <div class="mb-5 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <h2 class="text-xl font-bold text-slate-900">Production Logs</h2>

    <% if process_options.any? %>
      <button type="button"
              onclick="document.getElementById('<%= new_log_modal_id %>').showModal()"
              class="inline-flex h-9 cursor-pointer items-center justify-center rounded-md bg-slate-800 px-3 text-sm font-semibold text-white hover:bg-slate-900">
        Add Production Log
      </button>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-xl border border-slate-200">
    <table class="min-w-full table-fixed divide-y divide-slate-200 text-left text-sm">
      <thead class="bg-slate-900 text-white">
        <tr>
          <th class="w-28 px-4 py-3 font-semibold">Date</th>
          <th class="w-28 px-4 py-3 font-semibold">Process</th>
          <th class="w-40 px-4 py-3 font-semibold">Team Member</th>
          <th class="w-28 px-4 py-3 font-semibold">Start Time</th>
          <th class="w-28 px-4 py-3 font-semibold">End Time</th>
          <th class="w-24 px-4 py-3 font-semibold">Hours</th>
          <th class="w-64 px-4 py-3 font-semibold">Notes</th>
          <th class="w-36 px-4 py-3 font-semibold">Actions</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-slate-200">
        <% @production_logs.each do |log| %>
          <% job_process = log.job_process %>
          <% process_code = job_process&.process_code %>
          <% modal_id = "production-log-modal-#{log.id}" %>
          <tr class="align-middle hover:bg-slate-50">
            <td class="whitespace-nowrap px-4 py-3"><%= log.work_date&.strftime("%d/%m/%Y") || "-" %></td>
            <td class="whitespace-nowrap px-4 py-3 font-semibold text-slate-900"><%= process_code %></td>
            <td class="px-4 py-3"><span class="block truncate" title="<%= log.fabricator&.name || "-" %>"><%= log.fabricator&.name || "-" %></span></td>
            <td class="whitespace-nowrap px-4 py-3"><%= log.start_time&.strftime("%I:%M %p") || "-" %></td>
            <td class="whitespace-nowrap px-4 py-3"><%= log.end_time&.strftime("%I:%M %p") || "-" %></td>
            <td class="whitespace-nowrap px-4 py-3"><%= log.duration_hours.present? ? number_with_precision(log.duration_hours, precision: 2) : "-" %></td>
            <td class="px-4 py-3">
              <div class="truncate" title="<%= log.note.presence || "-" %>"><%= log.note.presence || "-" %></div>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-sm">
              <div class="flex items-center gap-2">
                <button type="button"
                        onclick="document.getElementById('<%= modal_id %>').showModal()"
                        class="inline-flex h-8 cursor-pointer items-center rounded-md border border-slate-300 bg-white px-3 text-xs font-semibold text-slate-700 hover:bg-slate-100">
                  Edit
                </button>

                <%= button_to "Delete",
                    admin_job_production_log_path(@job, log),
                    method: :delete,
                    form_class: "inline-flex",
                    form: { data: { turbo_confirm: "Delete this production log?" } },
                    class: "inline-flex h-8 cursor-pointer items-center rounded-md bg-red-700 px-3 text-xs font-semibold text-white hover:bg-red-800" %>
              </div>

              <dialog id="<%= modal_id %>" class="production-log-dialog w-[min(42rem,calc(100vw-2rem))] rounded-xl border border-slate-200 bg-white p-0 shadow-2xl">
                <div class="border-b border-slate-200 px-5 py-4">
                  <h3 class="text-lg font-bold text-slate-900">Edit Production Log</h3>
                </div>

                <%= form_with model: log,
                    url: admin_job_production_log_path(@job, log),
                    method: :patch,
                    local: true,
                    class: "p-5" do |form| %>
                  <div class="grid gap-4 md:grid-cols-2">
                    <div>
                      <%= form.label :work_date, "Date", class: "block text-xs font-semibold text-slate-600" %>
                      <%= form.date_field :work_date, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                    </div>

                    <div>
                      <%= label_tag "fabrication_log_process_code_#{log.id}", "Process", class: "block text-xs font-semibold text-slate-600" %>
                      <%= select_tag "fabrication_log[process_code]",
                          options_for_select(process_options, process_code),
                          id: "fabrication_log_process_code_#{log.id}",
                          required: true,
                          class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                    </div>

                    <div class="md:col-span-2">
                      <%= form.label :fabricator_id, "Team Member", class: "block text-xs font-semibold text-slate-600" %>
                      <%= form.collection_select :fabricator_id, @fabricators, :id, :name, { prompt: "Select" }, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                    </div>

                    <div>
                      <%= form.label :start_time, "Start Time", class: "block text-xs font-semibold text-slate-600" %>
                      <%= form.time_field :start_time, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                    </div>

                    <div>
                      <%= form.label :end_time, "End Time", class: "block text-xs font-semibold text-slate-600" %>
                      <%= form.time_field :end_time, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                    </div>

                    <div class="md:col-span-2">
                      <%= form.label :note, "Notes", class: "block text-xs font-semibold text-slate-600" %>
                      <%= form.text_area :note, rows: 3, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                    </div>
                  </div>

                  <div class="mt-5 flex justify-end gap-2">
                    <button type="button"
                            onclick="document.getElementById('<%= modal_id %>').close()"
                            class="cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">
                      Cancel
                    </button>

                    <%= form.submit "Save", class: "cursor-pointer rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
                  </div>
                <% end %>
              </dialog>
            </td>
          </tr>
        <% end %>

        <% if @production_logs.empty? %>
          <tr>
            <td colspan="8" class="px-4 py-8 text-center text-slate-500">
              No production logs found for this job.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if process_options.empty? %>
    <div class="mt-4 rounded-lg border border-dashed border-slate-300 px-4 py-5 text-center text-sm text-slate-500">
      No eligible production log processes are selected for this job.
    </div>
  <% else %>
    <dialog id="<%= new_log_modal_id %>" class="production-log-dialog w-[min(42rem,calc(100vw-2rem))] rounded-xl border border-slate-200 bg-white p-0 shadow-2xl">
      <div class="border-b border-slate-200 px-5 py-4">
        <h3 class="text-lg font-bold text-slate-900">Add Production Log</h3>
      </div>

      <%= form_with model: @production_log,
          url: admin_job_production_logs_path(@job),
          local: true,
          class: "p-5" do |form| %>
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <%= form.label :work_date, "Date", class: "block text-xs font-semibold text-slate-600" %>
            <%= form.date_field :work_date, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>

          <div>
            <%= label_tag "fabrication_log_process_code_new", "Process", class: "block text-xs font-semibold text-slate-600" %>
            <%= select_tag "fabrication_log[process_code]",
                options_for_select(process_options),
                id: "fabrication_log_process_code_new",
                required: true,
                class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>

          <div class="md:col-span-2">
            <%= form.label :fabricator_id, "Team Member", class: "block text-xs font-semibold text-slate-600" %>
            <%= form.collection_select :fabricator_id, @fabricators, :id, :name, { prompt: "Select" }, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>

          <div>
            <%= form.label :start_time, "Start Time", class: "block text-xs font-semibold text-slate-600" %>
            <%= form.time_field :start_time, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>

          <div>
            <%= form.label :end_time, "End Time", class: "block text-xs font-semibold text-slate-600" %>
            <%= form.time_field :end_time, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>

          <div class="md:col-span-2">
            <%= form.label :note, "Notes", class: "block text-xs font-semibold text-slate-600" %>
            <%= form.text_area :note, rows: 3, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
          </div>
        </div>

        <div class="mt-5 flex justify-end gap-2">
          <button type="button"
                  onclick="document.getElementById('<%= new_log_modal_id %>').close()"
                  class="cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">
            Cancel
          </button>

          <%= form.submit "Save", class: "cursor-pointer rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
        </div>
      <% end %>
    </dialog>
  <% end %>
</div>

  </div>
</div>
