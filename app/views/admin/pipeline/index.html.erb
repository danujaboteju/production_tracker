<div class="min-h-screen bg-gray-100 p-6">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Production Pipeline</h1>
      <p class="mt-1 text-sm text-gray-600">
        Read-only view of released production work grouped by process.
      </p>
    </div>

    <div class="flex gap-2">
      <%= link_to "Jobs",
          admin_jobs_path,
          class: "rounded-lg bg-gray-700 px-4 py-2 text-sm font-semibold text-white hover:bg-gray-800" %>

      <%= link_to "New Job",
          new_admin_job_path,
          class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
    </div>
  </div>

  <div class="overflow-x-auto">
    <div class="flex gap-4 pb-4">
      <% @process_options.each do |process_code, process_name| %>
        <% job_processes = @job_processes_by_code[process_code] || [] %>

        <div class="w-80 flex-shrink-0 rounded-xl bg-white shadow">
          <div class="border-b border-gray-200 p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h2 class="text-lg font-bold text-gray-900">
                  <%= process_code %>
                </h2>
                <p class="mt-1 text-sm text-gray-600">
                  <%= process_name %>
                </p>
              </div>

              <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">
                <%= job_processes.count %>
              </span>
            </div>
          </div>

          <div class="space-y-3 p-4">
            <% if job_processes.any? %>
              <% job_processes.each do |job_process| %>
                <% job = job_process.job %>

                <% process_status_class =
                  case job_process.status
                  when "Posted"
                    "bg-blue-100 text-blue-800"
                  when "In Progress"
                    "bg-yellow-100 text-yellow-800"
                  when "Partially Completed"
                    "bg-purple-100 text-purple-800"
                  when "On Hold"
                    "bg-red-100 text-red-800"
                  else
                    "bg-gray-100 text-gray-800"
                  end
                %>

                <% job_status_class =
                  case job.status
                  when "Released"
                    "bg-green-100 text-green-800"
                  when "In Progress"
                    "bg-yellow-100 text-yellow-800"
                  when "On Hold"
                    "bg-red-100 text-red-800"
                  when "Completed"
                    "bg-gray-200 text-gray-800"
                  else
                    "bg-gray-100 text-gray-800"
                  end
                %>

                <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div>
                      <h3 class="text-base font-bold text-gray-900">
                        <%= job.job_no %>
                      </h3>
                      <p class="mt-1 text-sm text-gray-700">
                        <%= job.customer_name %>
                      </p>
                    </div>

                    <%= link_to "Open",
                        admin_job_path(job),
                        class: "rounded-md bg-gray-800 px-3 py-1.5 text-xs font-semibold text-white hover:bg-gray-900" %>
                  </div>

                  <div class="space-y-2 text-sm">
                    <div class="flex justify-between gap-3">
                      <span class="text-gray-500">Due Date</span>
                      <span class="font-medium text-gray-900">
                        <%= job.due_date.present? ? job.due_date.strftime("%d %b %Y") : "-" %>
                      </span>
                    </div>

                    <div class="flex justify-between gap-3">
                      <span class="text-gray-500">Posted</span>
                      <span class="font-medium text-gray-900">
                        <%= job_process.posted_at.present? ? job_process.posted_at.strftime("%d %b %Y %I:%M %p") : "-" %>
                      </span>
                    </div>
                  </div>

                  <div class="mt-4 flex flex-wrap gap-2">
                    <span class="rounded-full px-3 py-1 text-xs font-semibold <%= job_status_class %>">
                      Job: <%= job.status %>
                    </span>

                    <span class="rounded-full px-3 py-1 text-xs font-semibold <%= process_status_class %>">
                      Process: <%= job_process.status %>
                    </span>
                  </div>
                </div>
              <% end %>
            <% else %>
              <div class="rounded-lg border border-dashed border-gray-300 p-4 text-center text-sm text-gray-500">
                No active work
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>