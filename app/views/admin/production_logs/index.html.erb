<style>
  dialog.production-log-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    max-height: calc(100vh - 2rem);
    overflow-y: auto;
  }

  @supports (height: 100dvh) {
    dialog.production-log-dialog {
      max-height: calc(100dvh - 2rem);
    }
  }

  dialog.production-log-dialog::backdrop {
    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(3px);
  }
</style>

<div class="min-h-screen bg-slate-100 p-6">
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <%= link_to "&larr; Back to Jobs".html_safe, admin_jobs_path,
            class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>
        <h1 class="mt-3 text-3xl font-bold text-slate-900">Production Logs</h1>
      </div>
    </div>

    <% if notice.present? %>
      <div class="mb-4 rounded-lg bg-green-100 px-4 py-3 text-green-800">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800">
        <%= alert %>
      </div>
    <% end %>

    <% if @filter_alert.present? %>
      <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800">
        <%= @filter_alert %>
      </div>
    <% end %>

    <div class="mb-6 rounded-xl bg-white p-5 shadow">
      <%= form_with url: admin_production_logs_path, method: :get, local: true, class: "grid gap-3 md:grid-cols-2 lg:grid-cols-[10rem_10rem_1fr_1fr_1fr_auto_auto] lg:items-end" do %>
        <div>
          <%= label_tag :date_from, "Date from", class: "block text-xs font-semibold text-slate-600" %>
          <%= date_field_tag :date_from, @date_from, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= label_tag :date_to, "Date to", class: "block text-xs font-semibold text-slate-600" %>
          <%= date_field_tag :date_to, @date_to, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= label_tag :process_code, "Process", class: "block text-xs font-semibold text-slate-600" %>
          <%= select_tag :process_code,
              options_for_select(@process_filter_options, @selected_process_code),
              prompt: "All processes",
              class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= label_tag :job_id, "Job", class: "block text-xs font-semibold text-slate-600" %>
          <%= select_tag :job_id,
              options_from_collection_for_select(@jobs, :id, ->(job) { "#{job.job_no} - #{job.customer_name}" }, @selected_job_id),
              prompt: "All jobs",
              class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= label_tag :fabricator_id, "Team Member", class: "block text-xs font-semibold text-slate-600" %>
          <%= select_tag :fabricator_id,
              options_from_collection_for_select(@fabricators, :id, :name, @selected_fabricator_id),
              prompt: "All team members",
              class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <%= submit_tag "Apply", class: "cursor-pointer rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
        <%= link_to "Clear", admin_production_logs_path, class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-center text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
      <% end %>
    </div>

    <div class="overflow-x-auto rounded-xl bg-white shadow">
      <table class="min-w-full table-fixed divide-y divide-slate-200 text-left text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="w-28 px-4 py-3 font-semibold">Date</th>
            <th class="w-44 px-4 py-3 font-semibold">Job</th>
            <th class="w-28 px-4 py-3 font-semibold">Process</th>
            <th class="w-40 px-4 py-3 font-semibold">Team Member</th>
            <th class="w-28 px-4 py-3 font-semibold">Start Time</th>
            <th class="w-28 px-4 py-3 font-semibold">End Time</th>
            <th class="w-24 px-4 py-3 font-semibold">Gross</th>
            <th class="w-24 px-4 py-3 font-semibold">Break</th>
            <th class="w-24 px-4 py-3 font-semibold">Job Hours</th>
            <th class="w-64 px-4 py-3 font-semibold">Notes</th>
            <th class="w-36 px-4 py-3 font-semibold">Actions</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-200">
          <% @fabrication_logs.each do |log| %>
            <% job_process = log.job_process %>
            <% log_job = job_process&.job %>
            <% process_code = job_process&.process_code %>
            <% process_config = process_code.present? ? Admin::ProductionLogsController::PROCESS_CONFIG[process_code] : nil %>
            <% modal_id = "production-log-modal-#{log.id}" %>
            <tr class="align-middle hover:bg-slate-50">
              <td class="whitespace-nowrap px-4 py-3"><%= log.work_date.strftime("%d/%m/%Y") %></td>
              <td class="px-4 py-3">
                <% if log_job.present? %>
                  <div class="truncate font-semibold text-slate-900" title="<%= log_job.job_no %>"><%= log_job.job_no %></div>
                  <div class="truncate text-xs text-slate-500" title="<%= log_job.customer_name %>"><%= log_job.customer_name %></div>
                <% else %>
                  <span class="block truncate font-semibold text-slate-900" title="<%= log.other_job_name.presence || "Other" %>"><%= log.other_job_name.presence || "Other" %></span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 font-semibold text-slate-900"><%= process_code.presence || "Other" %></td>
              <td class="px-4 py-3"><span class="block truncate" title="<%= log.fabricator.name %>"><%= log.fabricator.name %></span></td>
              <td class="whitespace-nowrap px-4 py-3"><%= log.start_time.strftime("%I:%M %p") %></td>
              <td class="whitespace-nowrap px-4 py-3"><%= log.end_time&.strftime("%I:%M %p") || "-" %></td>
              <td class="whitespace-nowrap px-4 py-3"><%= log.gross_duration_hours.present? ? number_with_precision(log.gross_duration_hours, precision: 2) : "-" %></td>
              <td class="whitespace-nowrap px-4 py-3"><%= log.break_duration_hours.present? ? number_with_precision(log.break_duration_hours, precision: 2) : "-" %></td>
              <td class="whitespace-nowrap px-4 py-3 font-semibold text-slate-900"><%= log.duration_hours.present? ? number_with_precision(log.duration_hours, precision: 2) : "-" %></td>
              <td class="px-4 py-3">
                <div class="truncate" title="<%= log.note.presence || "-" %>"><%= log.note.presence || "-" %></div>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-sm">
                <div class="flex items-center gap-2">
                  <button type="button"
                          onclick="document.getElementById('<%= modal_id %>').showModal()"
                          class="inline-flex h-8 cursor-pointer items-center rounded-md border border-slate-300 bg-white px-3 text-xs font-semibold text-slate-700 hover:bg-slate-100">
                    Edit
                  </button>

                  <%= button_to "Delete",
                      admin_production_log_path(log),
                      method: :delete,
                      params: { return_to: request.fullpath },
                      form_class: "inline-flex",
                      form: { data: { turbo_confirm: "Delete this production log?" } },
                      class: "inline-flex h-8 cursor-pointer items-center rounded-md bg-red-700 px-3 text-xs font-semibold text-white hover:bg-red-800" %>
                </div>

                <dialog id="<%= modal_id %>" class="production-log-dialog w-[min(42rem,calc(100vw-2rem))] rounded-xl border border-slate-200 bg-white p-0 shadow-2xl">
                  <div class="border-b border-slate-200 px-5 py-4">
                    <h2 class="text-lg font-bold text-slate-900">Edit Production Log</h2>
                  </div>

                  <%= form_with model: log,
                      url: admin_production_log_path(log),
                      method: :patch,
                      local: true,
                      data: { production_log_form: true },
                      class: "p-5" do |form| %>
                    <%= hidden_field_tag :return_to, request.fullpath %>

                    <div class="grid gap-4 md:grid-cols-2">
                      <div>
                        <%= form.label :work_date, "Date", class: "block text-xs font-semibold text-slate-600" %>
                        <%= form.date_field :work_date, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                      </div>

                      <div>
                        <%= label_tag "fabrication_log_process_code_#{log.id}", "Process", class: "block text-xs font-semibold text-slate-600" %>
                        <%= select_tag "fabrication_log[process_code]",
                            options_for_select([["Other", ""]] + @process_options.map { |code| [code, code] }, process_code),
                            id: "fabrication_log_process_code_#{log.id}",
                            data: { production_log_process_select: true },
                            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                      </div>

                      <div class="md:col-span-2">
                        <%= label_tag "fabrication_log_job_id_#{log.id}", "Job", class: "block text-xs font-semibold text-slate-600" %>
                        <%= select_tag "fabrication_log[job_id]",
                            options_from_collection_for_select(@jobs, :id, ->(job) { "#{job.job_no} - #{job.customer_name}" }, log_job&.id),
                            id: "fabrication_log_job_id_#{log.id}",
                            prompt: "Select job",
                            data: { production_log_job_select: true },
                            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-400" %>
                      </div>

                      <div class="md:col-span-2">
                        <%= form.label :other_job_name, "Other work name", class: "block text-xs font-semibold text-slate-600" %>
                        <%= form.text_field :other_job_name, value: log.other_job_name, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                      </div>

                      <div class="md:col-span-2">
                        <%= form.label :fabricator_id, "Team Member", class: "block text-xs font-semibold text-slate-600" %>
                        <%
                          fabricator_options = @fabricators.map do |fabricator|
                            [fabricator.name, fabricator.id, { data: { processes: @fabricator_process_codes.fetch(fabricator.id, []).join(",") } }]
                          end
                        %>
                        <%= form.select :fabricator_id,
                            options_for_select(fabricator_options, log.fabricator_id),
                            { include_blank: "Select team member" },
                            required: true,
                            data: { production_log_team_member_select: true },
                            class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                      </div>

                      <div>
                        <%= form.label :start_time, "Start Time", class: "block text-xs font-semibold text-slate-600" %>
                        <%= form.time_field :start_time, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                      </div>

                      <div>
                        <%= form.label :end_time, "End Time", class: "block text-xs font-semibold text-slate-600" %>
                        <%= form.time_field :end_time, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                      </div>

                      <div class="md:col-span-2">
                        <%= form.label :note, "Notes", class: "block text-xs font-semibold text-slate-600" %>
                        <%= form.text_area :note, rows: 3, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                      </div>
                    </div>

                    <div class="mt-5 flex justify-end gap-2">
                      <button type="button"
                              onclick="document.getElementById('<%= modal_id %>').close()"
                              class="cursor-pointer rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">
                        Cancel
                      </button>

                      <%= form.submit "Save", class: "cursor-pointer rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
                    </div>
                  <% end %>
                </dialog>
              </td>
            </tr>
          <% end %>

          <% if @fabrication_logs.empty? %>
            <tr>
              <td colspan="11" class="px-4 py-8 text-center text-slate-500">
                No production logs found.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  (function () {
    function assignedProcesses(option) {
      return (option.dataset.processes || "")
        .split(",")
        .map(function (process) { return process.trim().toUpperCase(); })
        .filter(Boolean);
    }

    function originalOptions(select) {
      if (!select.productionLogOriginalOptions) {
        select.productionLogOriginalOptions = Array.prototype.slice.call(select.options).map(function (option) {
          return option.cloneNode(true);
        });
      }

      return select.productionLogOriginalOptions.map(function (option) {
        return option.cloneNode(true);
      });
    }

    function filterTeamMembers(form) {
      var processSelect = form.querySelector("[data-production-log-process-select]");
      var teamMemberSelect = form.querySelector("[data-production-log-team-member-select]");

      if (!processSelect || !teamMemberSelect) return;

      var selectedValue = teamMemberSelect.value;
      var processCode = (processSelect.value || "").trim().toUpperCase();
      var options = originalOptions(teamMemberSelect);
      var blankOption = options.find(function (option) { return option.value === ""; });
      var allTeamMemberOptions = options.filter(function (option) { return option.value !== ""; });
      var assignedOptions = processCode ? options.filter(function (option) {
        return option.value !== "" && assignedProcesses(option).indexOf(processCode) !== -1;
      }) : allTeamMemberOptions;

      teamMemberSelect.replaceChildren.apply(
        teamMemberSelect,
        [blankOption].concat(assignedOptions).filter(Boolean)
      );

      var selectedStillAvailable = Array.prototype.some.call(teamMemberSelect.options, function (option) {
        return option.value === selectedValue;
      });
      teamMemberSelect.value = selectedStillAvailable ? selectedValue : "";
    }

    function updateJobSelect(form) {
      var processSelect = form.querySelector("[data-production-log-process-select]");
      var jobSelect = form.querySelector("[data-production-log-job-select]");

      if (!processSelect || !jobSelect) return;

      var processCode = (processSelect.value || "").trim();

      if (processCode === "") {
        jobSelect.value = "";
        jobSelect.disabled = true;
      } else {
        jobSelect.disabled = false;
      }
    }

    function setupProductionLogMemberFiltering() {
      document.querySelectorAll("[data-production-log-form]").forEach(function (form) {
        var processSelect = form.querySelector("[data-production-log-process-select]");

        if (!processSelect || form.dataset.memberFilteringReady === "true") return;

        form.dataset.memberFilteringReady = "true";
        processSelect.addEventListener("change", function () {
          updateJobSelect(form);
          filterTeamMembers(form);
        });
        updateJobSelect(form);
        filterTeamMembers(form);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupProductionLogMemberFiltering);
    } else {
      setupProductionLogMemberFiltering();
    }
  })();
</script>

