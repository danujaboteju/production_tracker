<div class="min-h-screen bg-slate-100 p-6">
  <div class="mx-auto max-w-7xl">
    <% if notice.present? %>
      <div class="mb-4 rounded-lg bg-green-100 px-4 py-3 text-green-800">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800">
        <%= alert %>
      </div>
    <% end %>

    <% if @filter_alert.present? %>
      <div class="mb-4 rounded-lg bg-red-100 px-4 py-3 text-red-800">
        <%= @filter_alert %>
      </div>
    <% end %>

    <div class="mb-6 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <%= link_to "&larr; Back to Jobs".html_safe, admin_jobs_path,
            class: "text-sm font-semibold text-blue-700 hover:text-blue-900" %>
        <h1 class="mt-3 text-3xl font-bold text-slate-900"><%= @process_code %> &ndash; <%= @process_title %></h1>
        <p class="mt-1 text-slate-600">Log and track process hours by team member. PROD logs are connected to job records.</p>
      </div>
    </div>

    <div class="mb-6 rounded-xl bg-white p-5 shadow">
      <h2 class="text-lg font-bold text-slate-900">New Log</h2>

      <%= form_with model: [:admin, @fabrication_log],
          url: public_send("admin_#{@process_slug}_logs_path"),
          local: true,
          data: { controller: "profab-log-form" },
          class: "mt-4 grid gap-3 md:grid-cols-4 lg:grid-cols-8 lg:items-end" do |form| %>
        <div class="md:col-span-2 lg:col-span-2">
          <%= form.label :fabricator_id, "Team Member", class: "block text-xs font-semibold text-slate-600" %>
          <%= form.collection_select :fabricator_id, @active_fabricators, :id, :name, { prompt: "Select" }, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <fieldset class="lg:col-span-1">
          <legend class="block text-xs font-semibold text-slate-600">Work Type</legend>
          <div class="mt-2 flex gap-3 text-sm font-semibold text-slate-700">
            <% @work_types.each do |work_type| %>
              <label class="inline-flex items-center gap-1.5">
                <%= form.radio_button :work_type, work_type, data: { profab_log_form_target: "workType", action: "profab-log-form#toggle" } %>
                <span><%= work_type %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div class="md:col-span-2 lg:col-span-2" data-profab-log-form-target="prodField">
          <%= form.label :job_id, "Job (In Progress)", class: "block text-xs font-semibold text-slate-600" %>
          <%= select_tag "fabrication_log[job_id]", options_from_collection_for_select(@eligible_jobs, :id, ->(job) { "#{job.job_no} - #{job.customer_name}" }), prompt: "Select job", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div class="hidden md:col-span-2 lg:col-span-2" data-profab-log-form-target="otherField">
          <%= form.label :other_job_name, "Other Job / Activity", class: "block text-xs font-semibold text-slate-600" %>
          <%= form.text_field :other_job_name, placeholder: "General Hand", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= form.label :work_date, "Date", class: "block text-xs font-semibold text-slate-600" %>
          <%= form.date_field :work_date, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= form.label :start_time, "Start Time", class: "block text-xs font-semibold text-slate-600" %>
          <%= form.time_field :start_time, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= form.label :end_time, "End Time", class: "block text-xs font-semibold text-slate-600" %>
          <%= form.time_field :end_time, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div class="md:col-span-3 lg:col-span-2">
          <%= form.label :note, "Note", class: "block text-xs font-semibold text-slate-600" %>
          <%= form.text_field :note, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <%= form.submit "Add Log", class: "cursor-pointer rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
      <% end %>
    </div>

    <div class="mb-6 rounded-xl bg-white p-5 shadow">
      <h2 class="text-lg font-bold text-slate-900">Filter Logs</h2>

      <%= form_with url: public_send("admin_#{@process_slug}_path"), method: :get, local: true, class: "mt-4 grid gap-3 md:grid-cols-2 lg:grid-cols-[10rem_10rem_1fr_1fr_auto_auto] lg:items-end" do %>
        <div>
          <%= label_tag :date, "Date", class: "block text-xs font-semibold text-slate-600" %>
          <%= date_field_tag :date, @work_date, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= label_tag :month, "Month", class: "block text-xs font-semibold text-slate-600" %>
          <%= month_field_tag :month, @selected_month, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= label_tag :job_id, "Job", class: "block text-xs font-semibold text-slate-600" %>
          <%= select_tag :job_id,
              options_from_collection_for_select(@filter_jobs, :id, ->(job) { "#{job.job_no} - #{job.customer_name}" }, @selected_job_id),
              prompt: "All Jobs",
              class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <div>
          <%= label_tag :fabricator_id, "Operator / Team Member", class: "block text-xs font-semibold text-slate-600" %>
          <%= select_tag :fabricator_id,
              options_from_collection_for_select(@filter_fabricators, :id, :name, @selected_fabricator_id),
              prompt: "All Operators",
              class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
        </div>

        <%= submit_tag "Apply Filters", class: "cursor-pointer rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
        <%= link_to "Clear Filters", public_send("admin_#{@process_slug}_path"), class: "rounded-md border border-slate-300 bg-white px-4 py-2 text-center text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
      <% end %>
    </div>

    <div class="mb-4 grid gap-3 md:grid-cols-2">
      <div class="rounded-xl bg-white p-4 shadow">
        <div class="text-xs font-semibold uppercase text-slate-500">Total Hours</div>
        <div class="mt-1 text-2xl font-bold text-slate-900"><%= number_with_precision(@total_hours, precision: 2) %></div>
      </div>

      <div class="rounded-xl bg-white p-4 shadow">
        <div class="text-xs font-semibold uppercase text-slate-500">Log Entries</div>
        <div class="mt-1 text-2xl font-bold text-slate-900"><%= @log_entries %></div>
      </div>
    </div>

    <div class="overflow-x-auto rounded-xl bg-white shadow">
      <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="px-4 py-3 font-semibold">Date</th>
            <th class="px-4 py-3 font-semibold">Job</th>
            <th class="px-4 py-3 font-semibold">Operator / Team Member</th>
            <th class="px-4 py-3 font-semibold">Start Time</th>
            <th class="px-4 py-3 font-semibold">End Time</th>
            <th class="px-4 py-3 font-semibold">Notes</th>
            <th class="px-4 py-3 font-semibold">Hours</th>
            <th class="px-4 py-3 font-semibold">Actions</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-slate-200">
          <% @fabrication_logs.each do |log| %>
            <% log_job = log.job_process&.job %>
            <tr class="align-top hover:bg-slate-50">
              <td class="whitespace-nowrap px-4 py-3"><%= log.work_date.strftime("%d/%m/%Y") %></td>
              <td class="px-4 py-3">
                <% if log.work_type == "PROD" && log_job.present? %>
                  <div class="font-semibold text-slate-900"><%= log_job.job_no %></div>
                  <div class="text-xs text-slate-500"><%= log_job.customer_name %></div>
                <% else %>
                  <span class="font-semibold text-slate-900">Other &mdash; <%= log.other_job_name %></span>
                <% end %>
              </td>
              <td class="px-4 py-3"><%= log.fabricator.name %></td>
              <td class="whitespace-nowrap px-4 py-3"><%= log.start_time.strftime("%I:%M %p") %></td>
              <td class="whitespace-nowrap px-4 py-3"><%= log.end_time&.strftime("%I:%M %p") || "-" %></td>
              <td class="px-4 py-3"><%= log.note.presence || "-" %></td>
              <td class="whitespace-nowrap px-4 py-3"><%= log.duration_hours.present? ? number_with_precision(log.duration_hours, precision: 2) : "-" %></td>
              <td class="px-4 py-3">
                <div class="flex flex-wrap gap-2">
                  <details>
                    <summary class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Edit</summary>
                    <div class="mt-3 w-[min(68rem,calc(100vw-4rem))] rounded-lg border border-slate-200 bg-white p-4 shadow">
                      <%= form_with model: [:admin, log],
                          url: public_send("admin_#{@process_slug}_log_path", log),
                          method: :patch,
                          local: true,
                          data: { controller: "profab-log-form" },
                          class: "grid gap-3 md:grid-cols-4 lg:grid-cols-8 lg:items-end" do |form| %>
                        <%= hidden_field_tag :return_to, request.fullpath %>

                        <div class="md:col-span-2 lg:col-span-2">
                          <%= form.label :fabricator_id, "Team Member", class: "block text-xs font-semibold text-slate-600" %>
                          <% fabricator_options = Array(@active_fabricators) %>
                          <% if log.fabricator.present? && fabricator_options.exclude?(log.fabricator) %>
                            <% fabricator_options = (fabricator_options + [log.fabricator]).sort_by { |fabricator| fabricator.name.downcase } %>
                          <% end %>
                          <%= form.collection_select :fabricator_id, fabricator_options, :id, :name, { prompt: "Select" }, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                        </div>

                        <fieldset>
                          <legend class="block text-xs font-semibold text-slate-600">Work Type</legend>
                          <div class="mt-2 flex gap-3 text-sm font-semibold text-slate-700">
                            <% @work_types.each do |work_type| %>
                              <label class="inline-flex items-center gap-1.5">
                                <%= form.radio_button :work_type, work_type, data: { profab_log_form_target: "workType", action: "profab-log-form#toggle" } %>
                                <span><%= work_type %></span>
                              </label>
                            <% end %>
                          </div>
                        </fieldset>

                        <div class="md:col-span-2 lg:col-span-2" data-profab-log-form-target="prodField">
                          <%= form.label :job_id, "Job (In Progress)", class: "block text-xs font-semibold text-slate-600" %>
                          <%= select_tag "fabrication_log[job_id]", options_from_collection_for_select(@eligible_jobs, :id, ->(job) { "#{job.job_no} - #{job.customer_name}" }, log_job&.id), prompt: "Select job", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                        </div>

                        <div class="hidden md:col-span-2 lg:col-span-2" data-profab-log-form-target="otherField">
                          <%= form.label :other_job_name, "Other Job / Activity", class: "block text-xs font-semibold text-slate-600" %>
                          <%= form.text_field :other_job_name, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                        </div>

                        <div>
                          <%= form.label :work_date, "Date", class: "block text-xs font-semibold text-slate-600" %>
                          <%= form.date_field :work_date, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                        </div>

                        <div>
                          <%= form.label :start_time, "Start Time", class: "block text-xs font-semibold text-slate-600" %>
                          <%= form.time_field :start_time, required: true, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                        </div>

                        <div>
                          <%= form.label :end_time, "End Time", class: "block text-xs font-semibold text-slate-600" %>
                          <%= form.time_field :end_time, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                        </div>

                        <div class="md:col-span-3 lg:col-span-2">
                          <%= form.label :note, "Note", class: "block text-xs font-semibold text-slate-600" %>
                          <%= form.text_field :note, class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
                        </div>

                        <%= form.submit "Save", class: "cursor-pointer rounded-md bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900" %>
                      <% end %>
                    </div>
                  </details>

                  <%= button_to "Delete",
                      public_send("admin_#{@process_slug}_log_path", log),
                      method: :delete,
                      params: { return_to: request.fullpath },
                      form_class: "inline-block",
                      form: { data: { turbo_confirm: "Delete this #{@process_code} log?" } },
                      class: "cursor-pointer rounded-md bg-red-700 px-3 py-2 text-sm font-semibold text-white hover:bg-red-800" %>
                </div>
              </td>
            </tr>
          <% end %>

          <% if @fabrication_logs.empty? %>
            <tr>
              <td colspan="8" class="px-4 py-8 text-center text-slate-500">
                No #{@process_code} logs match the selected filters.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
