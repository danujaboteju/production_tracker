<div class="min-h-screen w-full bg-slate-100 p-6">
  <div class="mx-auto mt-16 max-w-sm rounded-lg bg-white p-6 shadow">
    <h1 class="text-2xl font-bold text-slate-900">Admin Login</h1>

    <% if notice.present? %>
      <div class="mt-4 rounded-md bg-green-100 px-4 py-3 text-sm text-green-800">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mt-4 rounded-md bg-red-100 px-4 py-3 text-sm text-red-800">
        <%= alert %>
      </div>
    <% end %>

    <%= form_with url: session_path, local: true, data: { turbo: false }, class: "mt-6 space-y-4" do |form| %>
      <div>
        <%= form.label :username, "Username", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <div>
        <%= form.label :password, "Password", class: "block text-sm font-semibold text-slate-700" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-1 w-full rounded-md border border-slate-300 px-3 py-2 text-sm" %>
      </div>

      <%= form.submit "Log in", class: "w-full rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
    <% end %>

    <% if authenticated? %>
      <div class="mt-4 border-t border-slate-200 pt-4 text-sm text-slate-600">
        Signed in as <span class="font-semibold"><%= current_user.username %></span>.
        <%= button_to "Log out", session_path, method: :delete, class: "mt-3 rounded-md bg-slate-200 px-3 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-300" %>
      </div>
    <% end %>
  </div>
</div>
